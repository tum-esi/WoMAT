mas agent2ThingCommunication {    
    // ----------------------------------------
    // Agent 2 Thing communication example
    // ----------------------------------------
    // manufacturing example
    agent conveyor1: manufacturing_demo/conveyor1_agent.asl {
      focus: conveyor1.wotComm
    }

    agent conveyor2: manufacturing_demo/conveyor2_agent.asl {
      focus: conveyor2.wotComm
    }

    agent uarm: manufacturing_demo/uarm_agent.asl {
      focus: uarm.wotComm
    }
    
    agent ur10: manufacturing_demo/ur10_agent.asl {
      focus: ur10.wotComm
    }

    workspace conveyor1 {
      artifact wotComm: wotCommunication.wotCommunicator("conveyor1")
    }

    workspace conveyor2 {
      artifact wotComm: wotCommunication.wotCommunicator("conveyor2")
    }

    workspace uarm {
      artifact wotComm: wotCommunication.wotCommunicator("uarm")
    }

    workspace ur10 {
      artifact wotComm: wotCommunication.wotCommunicator("ur10")
    }


}
