{
  "compilerOptions": {
    "target": "es5",
    "module": "commonjs",
    "strict": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src/",
    "allowJs": true,         // Allow JavaScript files to be compiled
    "declaration": true,     // Generate declaration files (.d.ts)
    "declarationDir": "./types" // Output directory for declaration files
  },
  "exclude": [
    "node_modules"
  ],
  "include": [
    "*.ts",
    "src/**/*.ts",
    "src/**/*.js" // Include JavaScript files
  ]
}
