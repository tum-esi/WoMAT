mas agent2ThingCommunication {    
    // ----------------------------------------
    // Agent 2 Thing communication example
    // ----------------------------------------
    // manufacturing example
    agent agent2Thing: agent2Thing.asl {
      focus: agent2Thing.wotComm
    }
    workspace agent2Thing {
      artifact wotComm: wotCommunication.wotCommunicator("agent2Thing")
    }

}
