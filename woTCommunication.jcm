mas woTCommunication {    
    // ----------------------------------------
    // Manufacurtiring Lane Simulation
    // ----------------------------------------
    // manufacturing example
    agent robot0Agent: robot_0_agent.asl {
      focus: robot0.wotComm
    }
    agent robot1Agent: robot_1_agent.asl {
      focus: robot1.wotComm
    }
    workspace robot0 {
      artifact wotComm: wotCommunication.wotCommunicator("robotArm0")
    }
    workspace robot1 {
      artifact wotComm: wotCommunication.wotCommunicator("robotArm1")
    }

}
